{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@brevy/ui#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/catalog/src/**",
        "$TURBO_ROOT$/apps/catalog/scripts/**"
      ],
      "outputs": ["dist/**"]
    },
    "catalog#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/starter/**"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/brevy-landing-starter.zip"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false
    }
  }
}
